{
  "specVersion": "1.1.0",
  "api": "v1",
  "userAgent": {
    "languages": ["typescript", "dotnet", "swift", "kotlin", "python", "go", "rust", "c"],
    "pattern": "^bydev-(typescript|dotnet|swift|kotlin|python|go|rust|c)/[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?( .+)?$"
  },
  "http": {
    "timeoutSec": 30
  },
  "login": {
    "pollJitter": { "min": 1.0, "max": 1.15 },
    "slowDownIncrementSec": 5
  },
  "token": {
    "refreshSkewSec": 60,
    "refreshRetryDelaysSec": [1, 3, 7],
    "clockLeewaySec": 60
  },
  "session": {
    "heartbeatJitter": { "min": 0.85, "max": 1.15 },
    "startRetryDelaysSec": [2, 5, 10, 30, 60]
  },
  "jwks": {
    "defaultMaxAgeSec": 300,
    "unknownKidRefetchMinIntervalSec": 60
  },
  "fingerprint": {
    "algorithm": "SHA-256",
    "salt": "bydev-device-v1",
    "encoding": "hex-lower"
  },
  "storage": {
    "service": "dev.developedby.sdk",
    "recordVersion": 1
  },
  "transient": {
    "codes": ["NETWORK_ERROR", "RATE_LIMITED", "INTERNAL_ERROR"],
    "unknownCodeStatuses": [429],
    "unknownCodeStatusRanges": [[500, 599]]
  },
  "webhook": {
    "signatureVersion": "v1",
    "secretPrefix": "whsec_",
    "toleranceSec": 300
  },
  "sdkErrorCodes": [
    "NETWORK_ERROR",
    "PROTOCOL_ERROR",
    "STORAGE_FAILED",
    "NOT_SIGNED_IN",
    "TOKEN_INVALID",
    "GENERATION_REGRESSED",
    "OFFLINE_EXPIRED",
    "DOWNLOAD_INTEGRITY",
    "LOGIN_CANCELLED",
    "CONFIGURATION",
    "WEBHOOK_INVALID"
  ],
  "sessionStates": ["Starting", "Active", "Degraded", "NeedsDecision", "Locked", "Stopped"],
  "needsDecisionReasons": ["DEVICE_IN_USE", "INSTANCE_ALREADY_RUNNING", "DEVICE_LIMIT_EXCEEDED"]
}
