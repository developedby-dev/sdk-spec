{
  "name": "login-storage-failure",
  "title": "승인된 토큰을 저장하지 못하면 쓰지 않고 STORAGE_FAILED",
  "specSections": ["5", "6"],
  "random": [0],
  "steps": [
    {
      "call": "login.start",
      "id": "start"
    },
    {
      "request": {
        "operation": "issueDeviceCode",
        "body": {
          "client_id": "cli_01J9M0Y6X4N3Q8ZD5R2KT7VCPW",
          "scope": "entitlement.read session.write device.manage version.read profile.read"
        }
      },
      "atSec": 0,
      "respond": {
        "status": 200,
        "body": {
          "$deviceCodeResponse": {
            "interval": 5
          }
        }
      }
    },
    {
      "result": {
        "id": "start",
        "ok": true,
        "value": {
          "userCode": "BCDF-GHJK",
          "expiresAt": {
            "$at": "+900s"
          }
        }
      }
    },
    {
      "call": "login.wait",
      "id": "wait"
    },
    {
      "set": "storage.failSave",
      "value": true
    },
    {
      "advanceSec": 5
    },
    {
      "request": {
        "operation": "exchangeToken",
        "body": {
          "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
          "device_code": "dc_Q8ZD5R2KT7VCPW01J9M0Y6X4N3"
        }
      },
      "atSec": 5,
      "respond": {
        "status": 200,
        "body": {
          "$tokenResponse": {
            "refreshToken": "rt_conf_login_0000000004"
          }
        }
      }
    },
    {
      "result": {
        "id": "wait",
        "ok": false,
        "error": {
          "code": "STORAGE_FAILED"
        }
      }
    },
    {
      "set": "storage.failSave",
      "value": false
    },
    {
      "call": "hasCredentials",
      "id": "has"
    },
    {
      "result": {
        "id": "has",
        "ok": true,
        "value": false
      }
    }
  ]
}
